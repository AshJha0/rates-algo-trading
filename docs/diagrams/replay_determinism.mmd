%% Title: Live run, journals, replay and the outbound hash comparison, restart on the same journals (1.1.0), and what repeats on the v2 desk profile (1.2.0)
flowchart LR
  subgraph live["Live run (LoopRunner)"]
    rings["Inbound rings<br/>InboundPublisher"]
    lloop["EventLoop<br/>EventClock latched once per cycle"]
    agents["Agents<br/>not journaled"]
  end
  inj[("Inbound SegmentedJournal<br/>messages, clock ticks,<br/>Backpressure, LoopError")]
  outj[("Outbound SegmentedJournal<br/>every message the loop produced")]
  subgraph rep["Replay (LoopReplay.run)"]
    replayer["Replayer<br/>ManualClock set to each frame's timestampNanos"]
    factory["LoopFactory<br/>same factory as live, fresh loop at the first frame"]
    rloop["Replay EventLoop<br/>onReplayFrame, agents do not run"]
    verifier["Outbound verifier<br/>ChainHash from the genesis hash"]
  end
  result{"ReplayResult<br/>matches"}
  same["Equal counts and final hashes,<br/>firstMismatch 0"]
  diff["firstMismatch: sequence of the first<br/>produced message that differs"]

  rings -->|drain, journal then dispatch| lloop
  agents -->|effects only as inbound messages| rings
  lloop -->|append inbound| inj
  lloop -->|append outbound before the ring| outj
  inj -->|frames in order| replayer
  replayer -->|first frame| factory
  factory -->|builds| rloop
  rloop -->|"tick: poll timers<br/>Backpressure: call the listener<br/>LoopError: stop<br/>other: dispatch"| rloop
  rloop -->|produced messages| verifier
  outj -->|recorded frames| verifier
  verifier -->|counts and hashes| result
  result -->|yes| same
  result -->|no| diff

  subgraph rst["Restart on existing journals (TradingProcess, 1.1.0)"]
    repair{"JournalRecovery.repair<br/>failed last frame, only zeros after?"}
    cut["Torn tail cut and counted<br/>journalTornTails"]
    lrec["LoopRecovery<br/>inbound journal into the live EventLoop,<br/>RecoveryClock set to each frame"]
    check{"Produced messages equal<br/>the recorded outbound journal?"}
    golive["RecoveryClock goes live<br/>GatewayStatus DISCONNECTED journaled<br/>feed rebuild required"]
    logon["Sessions log on<br/>sequence numbers resumed (MappedSequenceStore)"]
    reconciling["CLOB RECONCILING (4)<br/>OrderMassStatusRequest"]
    reconciled["RECONCILED (5)<br/>venue usable, ready once the book is whole"]
    refuse["Restart refused<br/>process does not start"]
  end

  inj -->|on restart| repair
  outj -->|on restart| repair
  repair -->|yes| cut
  repair -->|no damage| lrec
  repair -->|"other damage, missing segment, bad header"| refuse
  cut --> lrec
  lrec --> check
  check -->|"yes; extra messages journaled, not sent"| golive
  check -->|"no, outbound past inbound, or trailing LoopError"| refuse
  golive --> logon
  logon --> reconciling
  reconciling -->|answers passed to the loop| reconciled

  subgraph det["What is promised (1.2.0, DESK_V2_WIRING.md Section 12.2)"]
    p1["Replay of any journal, stepped or threaded:<br/>exact, outbound bytes equal"]
    p2["Stepped day, same seed:<br/>repeats frame for frame, timestamps included"]
    p3["Threaded live v2 day:<br/>NOT repeatable run to run<br/>(43,462 and 43,104 inbound frames in two runs);<br/>each run reconciles with 0 breaks and replays"]
  end
  inj -->|any run| p1
  p2 -.->|writes| inj
  p3 -.->|writes| inj
