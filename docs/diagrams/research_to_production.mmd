%% Title: From a research fit to a parameter the quoting engine reads
flowchart TD
  nb["Notebook research/notebooks/hitrate.ipynb<br/>thin wrapper, executed by tools/run_notebooks.py"]
  fit["ratesresearch.hitrate.fit<br/>logistic MLE, out-of-sample log-loss"]
  write["ratesresearch.presets.write_preset<br/>validate_preset checks the schema"]
  yaml["data/presets.yaml<br/>value and standard_error per parameter,<br/>assumption band low, central, high"]
  pr["Pull request<br/>CI and one approving review (CONTRIBUTING.md)"]
  bt["Back-tester<br/>Presets reader, usd_rfq_hit_rate,<br/>run at every band point"]
  exp["ExperimentCli<br/>pre-registration and ledger"]
  hrp["HitRatePreset.load<br/>preset quoting_hit_rate_default"]
  shipped["Shipped default<br/>rates-quoting quoting-hit-rate-default.yaml<br/>declared assumption, DR-P3-02"]
  desk["Desk Inputs<br/>HitRateModel, feedback clamped to the band"]
  qe["QuotingEngine<br/>spread from P of win, Section 12.2"]
  proc["OpsProcessMain<br/>deploy/config validated by ProcessConfig at start"]

  nb -->|calls| fit
  fit -->|coefficients and standard errors| write
  write -->|insert or replace by name| yaml
  yaml -->|reviewed as a diff| pr
  pr -->|merged| bt
  bt -->|band runs| exp
  pr -.->|"quoting_hit_rate_default not yet in the file"| hrp
  shipped -->|"used when the file has no such preset"| hrp
  hrp -->|coefficients and band| desk
  desk -->|win probability| qe
  qe -.->|bound at integration| proc
