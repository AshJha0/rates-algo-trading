flowchart TD
  fit["Fitting period runs<br/>baseline strategy on fitting sessions"]
  est["Estimates<br/>ratesresearch.markouts, hitrate, flow<br/>written to the experiment config and presets"]
  cfg["Experiment config<br/>data/experiments/ID.config.yaml"]
  pre["Pre-registration<br/>data/preregs/ID.yaml<br/>hypothesis, metric, periods, holdout,<br/>threshold, band, config_sha256"]
  commit["Commit before the run<br/>signed pre-registration in its own pull request<br/>(CONTRIBUTING.md)"]
  cli{"ExperimentCli<br/>validates"}
  refuse["Refused, exit 2<br/>nothing run, nothing recorded"]
  run["Run on the evaluation sessions<br/>every strategy at low, central, high"]
  stats["Statistics<br/>Welch, Holm, block bootstrap"]
  ledger["Ledger line appended<br/>data/ledger/ledger.jsonl<br/>hashes, results, verdict, prev_sha256"]
  holdout{"Open the holdout?"}
  once["Holdout run, once<br/>a second attempt is refused"]
  next["New pre-registration<br/>for any changed question"]
  pyval["ratesresearch.prereg.validate<br/>the same rules in Python"]
  recompute["ratesresearch.backtest_analysis<br/>recompute_experiment from the ledger line"]

  fit --> est --> cfg --> pre --> commit --> cli
  cli -->|missing, invalid, overlap,<br/>hash mismatch, holdout opened| refuse
  cli -->|valid| run --> stats --> ledger --> holdout
  holdout -->|yes| once --> ledger
  holdout -->|no| next
  ledger --> next
  pre -->|also validated by| pyval
  ledger -->|statistics re-derived| recompute

  subgraph v2["Simulator v2 family (1.2.0): prereg_version 2"]
    reg["Family registration<br/>research/prereg/ID.yaml, kind family<br/>signed and committed before the run"]
    draft["Status draft or unsigned:<br/>refused, nothing run"]
    pilot["Timing-only pilot<br/>pilot seed base, --timing-only<br/>no P&L written or read, no ledger row"]
    runner{"ExperimentRunner validates<br/>SessionDesign, BandParameters,<br/>SpentData, excluded band points refused"}
    sess["Per session: one journal written once from the seed;<br/>every arm on a fresh model of the same seed"]
    ckpt["Checkpoints per session and arm<br/>a killed run resumes at the next arm"]
    summary["summary.json once, after the last session"]
    rows["Ledger rows: one per hypothesis<br/>plus the descriptive row; one look per family run"]
    bh["LedgerCli --bh family:ID<br/>Benjamini-Hochberg, by command only"]
  end
  reg --> runner
  reg -.->|optional, before the run| pilot
  runner -->|draft| draft
  runner -->|valid| sess --> ckpt --> summary --> rows --> bh
  rows -->|appended to| ledger
