flowchart LR
  d2c["D2C RFQ simulator<br/>FIX 4.4 (rates-venues)"]
  clob["CLOB simulator<br/>FIX 4.4 and SBE book feed"]
  curvefeed["Curve feed<br/>CurveInput, Heartbeat"]
  session["VenueSession (rates-app)<br/>VenueGateway: FIX to SBE<br/>bounded Logon retry"]
  feed["FeedBinding<br/>gap: snapshot, GatewayStatus"]
  router_in["InboundRouter<br/>partition by instrument group"]
  ring_in["Inbound ring<br/>one per group"]
  loop["Event loop per group (rates-core)<br/>DeskGroup (rates-app): pricing, book,<br/>quoting, risk, hedger, routers"]
  journals["Journals<br/>in, out, route"]
  ring_out["Outbound rings<br/>D2C, CLOB, control"]
  control["Control endpoint<br/>kill switch, status, metrics"]
  replay["LoopReplay<br/>outbound hash comparison"]
  keeper["Position keeper<br/>venue reconciliation"]
  backtest["Back-tester (rates-backtest)<br/>DeskStrategy (rates-app) or<br/>DeskQuoter with sliced hedges (rates-strategy),<br/>daily report"]
  research["Python research<br/>ratesresearch"]

  d2c --> session
  clob --> session
  clob --> feed
  session --> router_in
  feed --> router_in
  curvefeed --> router_in
  control -->|KillSwitch| router_in
  router_in --> ring_in --> loop
  loop -->|every input and output| journals
  loop --> ring_out --> session
  session --> d2c
  session --> clob
  loop -->|status agent| control
  journals --> replay
  journals --> keeper
  journals -->|export| backtest
  journals --> research
  backtest --> research
