<?xml version="1.0" encoding="UTF-8"?>
<!--
  rates-algo-trading SBE schema, version 1.

  This file is the source of truth for every message that crosses a ring buffer
  or lands in the journal (API_SPEC.md Section 2). Codecs are generated at build
  time into io.ratesalgo.messages.sbe. All messages are fixed length in v1; the
  schema version is bumped, never edited in place, once a version has shipped.

  Units (API_SPEC.md Section 0): prices and rates are int64 mantissas with a
  fixed exponent of -9 (1.0 == 1_000_000_000); quantities are int64 in minor
  units of notional or face; times are epoch nanoseconds (int64); instrument,
  client, venue and account ids are int32 from the securities and party masters.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="io.ratesalgo.messages.sbe"
                   id="1"
                   version="0"
                   semanticVersion="1.0.0"
                   description="rates-algo-trading messages v1"
                   byteOrder="littleEndian">

  <types>
    <composite name="messageHeader" description="Message identifiers and length of message root">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId" primitiveType="uint16"/>
      <type name="schemaId" primitiveType="uint16"/>
      <type name="version" primitiveType="uint16"/>
    </composite>

    <composite name="Decimal9" description="Fixed-point number: mantissa * 10^-9">
      <type name="mantissa" primitiveType="int64"/>
      <type name="exponent" primitiveType="int8" presence="constant">-9</type>
    </composite>

    <type name="Ccy" primitiveType="char" length="3" characterEncoding="ASCII" description="ISO 4217 currency code"/>
    <type name="Tenor" primitiveType="char" length="4" characterEncoding="ASCII" description="Tenor code such as 10Y, 3M, padded with spaces"/>
    <type name="EpochNanos" primitiveType="int64" description="Nanoseconds since 1970-01-01T00:00:00Z"/>
    <type name="Quantity" primitiveType="int64" description="Minor units of notional or face"/>
    <type name="InstrumentId" primitiveType="int32"/>
    <type name="PartyId" primitiveType="int32"/>
    <type name="VenueId" primitiveType="int32"/>
    <type name="SeqNo" primitiveType="int64"/>

    <enum name="Side" encodingType="uint8">
      <validValue name="Buy">1</validValue>
      <validValue name="Sell">2</validValue>
    </enum>

    <enum name="BookAction" encodingType="uint8">
      <validValue name="Add">1</validValue>
      <validValue name="Change">2</validValue>
      <validValue name="Delete">3</validValue>
      <validValue name="Clear">4</validValue>
    </enum>

    <enum name="QuoteStatus" encodingType="uint8" description="Outcome of a quote in an RFQ">
      <validValue name="Done">1</validValue>
      <validValue name="TradedAway">2</validValue>
      <validValue name="Expired">3</validValue>
      <validValue name="Rejected">4</validValue>
      <validValue name="Passed">5</validValue>
      <validValue name="DoneAway">6</validValue>
    </enum>

    <enum name="OrdStatus" encodingType="uint8">
      <validValue name="New">0</validValue>
      <validValue name="PartiallyFilled">1</validValue>
      <validValue name="Filled">2</validValue>
      <validValue name="Cancelled">4</validValue>
      <validValue name="Rejected">8</validValue>
    </enum>

    <enum name="OrdType" encodingType="uint8">
      <validValue name="Market">1</validValue>
      <validValue name="Limit">2</validValue>
    </enum>

    <enum name="TimeInForce" encodingType="uint8">
      <validValue name="Day">0</validValue>
      <validValue name="ImmediateOrCancel">3</validValue>
      <validValue name="FillOrKill">4</validValue>
      <validValue name="GoodTillDate">6</validValue>
    </enum>

    <enum name="CurveInputKind" encodingType="uint8">
      <validValue name="Fixing">1</validValue>
      <validValue name="Future">2</validValue>
      <validValue name="ParSwap">3</validValue>
      <validValue name="Bond">4</validValue>
    </enum>

    <enum name="LimitKind" encodingType="uint8">
      <validValue name="Position">1</validValue>
      <validValue name="BucketDv01">2</validValue>
      <validValue name="NetDv01">3</validValue>
      <validValue name="GrossDv01">4</validValue>
      <validValue name="DailyLoss">5</validValue>
      <validValue name="OrderRate">6</validValue>
      <validValue name="QuoteRate">7</validValue>
      <validValue name="MaxOrderSize">8</validValue>
      <validValue name="PriceCollar">9</validValue>
    </enum>

    <enum name="KillReason" encodingType="uint8">
      <validValue name="Manual">1</validValue>
      <validValue name="LimitBreach">2</validValue>
      <validValue name="FeedGap">3</validValue>
      <validValue name="SessionLoss">4</validValue>
      <validValue name="StaleReference">5</validValue>
    </enum>
    <!-- P4 router (API_SPEC.md Sections 2 and 15). Appended; no existing type changes. -->
    <enum name="VenueKind" encodingType="uint8">
      <validValue name="Clob">1</validValue>
      <validValue name="Futures">2</validValue>
    </enum>

    <enum name="RouteReason" encodingType="uint8" description="Why the router made an allocation decision">
      <validValue name="Slice">1</validValue>
      <validValue name="Escalation">2</validValue>
      <validValue name="BookMove">3</validValue>
      <validValue name="Retry">4</validValue>
      <validValue name="Deadline">5</validValue>
      <validValue name="Reconcile">6</validValue>
    </enum>

    <enum name="VenueExclusion" encodingType="uint8" description="Why a venue received nothing in a decision">
      <validValue name="None">0</validValue>
      <validValue name="NoQuote">1</validValue>
      <validValue name="SelfCross">2</validValue>
      <validValue name="BelowMinimum">3</validValue>
      <validValue name="CapReached">4</validValue>
      <validValue name="LimitPrice">5</validValue>
    </enum>

    <enum name="ChildState" encodingType="uint8" description="Router child order state (API_SPEC.md Section 15.4)">
      <validValue name="New">1</validValue>
      <validValue name="Acknowledged">2</validValue>
      <validValue name="PartiallyFilled">3</validValue>
      <validValue name="Filled">4</validValue>
      <validValue name="CancelRequested">5</validValue>
      <validValue name="Cancelled">6</validValue>
      <validValue name="Replaced">7</validValue>
      <validValue name="Rejected">8</validValue>
    </enum>

    <enum name="TransitionCause" encodingType="uint8">
      <validValue name="Sent">1</validValue>
      <validValue name="Ack">2</validValue>
      <validValue name="Fill">3</validValue>
      <validValue name="CancelSent">4</validValue>
      <validValue name="CancelConfirmed">5</validValue>
      <validValue name="Rejected">6</validValue>
      <validValue name="CancelRejected">7</validValue>
      <validValue name="Reconciled">8</validValue>
    </enum>

    <!-- P6 post-trade (template ids 100 to 119, API_SPEC.md Sections 2 and 17). -->
    <enum name="TradeSource" encodingType="uint8" description="Which message created the trade">
      <validValue name="Execution">1</validValue>
      <validValue name="Rfq">2</validValue>
    </enum>

    <enum name="BustReason" encodingType="uint8">
      <validValue name="VenueError">1</validValue>
      <validValue name="ClearingRejected">2</validValue>
      <validValue name="ErroneousTrade">3</validValue>
      <validValue name="Manual">4</validValue>
    </enum>

    <enum name="AmendReason" encodingType="uint8">
      <validValue name="PriceCorrection">1</validValue>
      <validValue name="QuantityCorrection">2</validValue>
      <validValue name="Reallocation">3</validValue>
    </enum>

    <enum name="MdRejectReason" encodingType="uint8" description="Why a market data input was kept out of the composite (API_SPEC.md Section 11)">
      <validValue name="CrossedQuote">1</validValue>
      <validValue name="LockedQuote">2</validValue>
      <validValue name="NonPositivePrice">3</validValue>
      <validValue name="Outlier">4</validValue>
      <validValue name="Stale">5</validValue>
      <validValue name="CrossedComposite">6</validValue>
      <validValue name="LockedComposite">7</validValue>
      <validValue name="FixingRepublicationLate">8</validValue>
      <validValue name="FixingRepublicationUnchanged">9</validValue>
      <validValue name="SequenceGap">10</validValue>
      <validValue name="OutOfOrder">11</validValue>
      <validValue name="UnknownInstrument">12</validValue>
    </enum>
  </types>

  <sbe:message name="Heartbeat" id="1" description="Liveness of a source; also the clock tick in replay">
    <field name="sourceId" id="1" type="int32"/>
    <field name="timestampNanos" id="2" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="BookUpdate" id="2" description="One price level change on a CLOB">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="instrumentId" id="2" type="InstrumentId"/>
    <field name="venueSeqNo" id="3" type="SeqNo"/>
    <field name="side" id="4" type="Side"/>
    <field name="action" id="5" type="BookAction"/>
    <field name="level" id="6" type="uint8"/>
    <field name="price" id="7" type="Decimal9"/>
    <field name="quantity" id="8" type="Quantity"/>
    <field name="orderCount" id="9" type="int32"/>
    <field name="timestampNanos" id="10" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="CurveInput" id="3" description="A curve instrument quote or fixing used by the bootstrap">
    <field name="curveId" id="1" type="int32"/>
    <field name="kind" id="2" type="CurveInputKind"/>
    <field name="instrumentId" id="3" type="InstrumentId"/>
    <field name="tenor" id="4" type="Tenor"/>
    <field name="value" id="5" type="Decimal9" description="Rate, price or fixing in the instrument's own quoting convention"/>
    <field name="timestampNanos" id="6" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="QuoteRequest" id="10" description="Inbound RFQ from a client via a venue">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="rfqId" id="2" type="int64"/>
    <field name="clientId" id="3" type="PartyId"/>
    <field name="instrumentId" id="4" type="InstrumentId"/>
    <field name="side" id="5" type="Side" description="Side from the client's point of view"/>
    <field name="quantity" id="6" type="Quantity"/>
    <field name="currency" id="7" type="Ccy"/>
    <field name="dealerCount" id="8" type="uint8" description="Number of dealers in competition, when the venue discloses it"/>
    <field name="receivedNanos" id="9" type="EpochNanos"/>
    <field name="expiryNanos" id="10" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="Quote" id="11" description="Our response to an RFQ">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="rfqId" id="2" type="int64"/>
    <field name="quoteId" id="3" type="int64"/>
    <field name="instrumentId" id="4" type="InstrumentId"/>
    <field name="bidPrice" id="5" type="Decimal9"/>
    <field name="askPrice" id="6" type="Decimal9"/>
    <field name="bidQuantity" id="7" type="Quantity"/>
    <field name="askQuantity" id="8" type="Quantity"/>
    <field name="referenceNanos" id="9" type="EpochNanos" description="Timestamp of the newest input the price depends on"/>
    <field name="validUntilNanos" id="10" type="EpochNanos"/>
    <field name="sentNanos" id="11" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="QuoteResponse" id="12" description="Venue's outcome for one of our quotes">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="rfqId" id="2" type="int64"/>
    <field name="quoteId" id="3" type="int64"/>
    <field name="status" id="4" type="QuoteStatus"/>
    <field name="tradedPrice" id="5" type="Decimal9"/>
    <field name="tradedQuantity" id="6" type="Quantity"/>
    <field name="coverPrice" id="7" type="Decimal9" description="Second-best price, when the venue discloses it to the winner"/>
    <field name="timestampNanos" id="8" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="NewOrder" id="20" description="Outbound order to a CLOB or futures venue">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="clOrdId" id="2" type="int64"/>
    <field name="parentId" id="3" type="int64" description="Router parent order, 0 if none"/>
    <field name="instrumentId" id="4" type="InstrumentId"/>
    <field name="side" id="5" type="Side"/>
    <field name="ordType" id="6" type="OrdType"/>
    <field name="timeInForce" id="7" type="TimeInForce"/>
    <field name="price" id="8" type="Decimal9"/>
    <field name="quantity" id="9" type="Quantity"/>
    <field name="expireNanos" id="10" type="EpochNanos"/>
    <field name="sentNanos" id="11" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="ExecutionReport" id="21" description="Order state change or fill from a venue">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="clOrdId" id="2" type="int64"/>
    <field name="venueOrderId" id="3" type="int64"/>
    <field name="execId" id="4" type="int64"/>
    <field name="instrumentId" id="5" type="InstrumentId"/>
    <field name="side" id="6" type="Side"/>
    <field name="ordStatus" id="7" type="OrdStatus"/>
    <field name="lastPrice" id="8" type="Decimal9"/>
    <field name="lastQuantity" id="9" type="Quantity"/>
    <field name="leavesQuantity" id="10" type="Quantity"/>
    <field name="cumQuantity" id="11" type="Quantity"/>
    <field name="transactNanos" id="12" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="RiskLimitBreach" id="30" description="A pre-trade or post-trade limit was hit">
    <field name="limitKind" id="1" type="LimitKind"/>
    <field name="scopeId" id="2" type="int32" description="Instrument, bucket or account the limit applies to"/>
    <field name="limitValue" id="3" type="Decimal9"/>
    <field name="observedValue" id="4" type="Decimal9"/>
    <field name="rejectedMessageSeqNo" id="5" type="SeqNo" description="Journal sequence of the message rejected, 0 if post-trade"/>
    <field name="timestampNanos" id="6" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="KillSwitch" id="31" description="Pull every quote, cancel every order, block new ones">
    <field name="reason" id="1" type="KillReason"/>
    <field name="scopeId" id="2" type="int32" description="0 for the whole process, else an instrument group"/>
    <field name="requestedBy" id="3" type="PartyId"/>
    <field name="timestampNanos" id="4" type="EpochNanos"/>
  </sbe:message>

  <!-- P4 router messages, template ids 80 to 89 reserved for the router (API_SPEC.md Section 15). -->
  <sbe:message name="RouteDecision" id="80" description="Header of one routing decision; followed by venueCount RouteDecisionVenue rows">
    <field name="decisionId" id="1" type="int64"/>
    <field name="parentId" id="2" type="int64"/>
    <field name="instrumentId" id="3" type="InstrumentId"/>
    <field name="side" id="4" type="Side"/>
    <field name="reason" id="5" type="RouteReason"/>
    <field name="configVersion" id="6" type="int32"/>
    <field name="venueCount" id="7" type="uint8"/>
    <field name="sliceIndex" id="8" type="int32"/>
    <field name="parentQuantity" id="9" type="Quantity"/>
    <field name="sliceQuantity" id="10" type="Quantity"/>
    <field name="allocatedQuantity" id="11" type="Quantity"/>
    <field name="urgency" id="12" type="Decimal9"/>
    <field name="passiveHorizonNanos" id="13" type="int64" description="Passive time limit; 0 means passive is not allowed in this decision"/>
    <field name="sliceIntervalNanos" id="14" type="int64" description="Interval used for the participation cap"/>
    <field name="arrivalMid" id="15" type="Decimal9"/>
    <field name="expectedCost" id="16" type="Decimal9" description="Quantity-weighted expected cost per unit, price points"/>
    <field name="timestampNanos" id="17" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="RouteDecisionVenue" id="81" description="One venue row of a routing decision: cost inputs, costs and the allocation">
    <field name="decisionId" id="1" type="int64"/>
    <field name="row" id="2" type="uint8"/>
    <field name="venueId" id="3" type="VenueId"/>
    <field name="kind" id="4" type="VenueKind"/>
    <field name="bestBid" id="5" type="Decimal9"/>
    <field name="bestAsk" id="6" type="Decimal9"/>
    <field name="tick" id="7" type="Decimal9"/>
    <field name="lotSize" id="8" type="Quantity"/>
    <field name="minSize" id="9" type="Quantity"/>
    <field name="sameSideDepth" id="10" type="Quantity"/>
    <field name="oppositeDepth" id="11" type="Quantity"/>
    <field name="tradeRate" id="12" type="Decimal9" description="Quantity per second"/>
    <field name="takerFee" id="13" type="Decimal9"/>
    <field name="makerFee" id="14" type="Decimal9"/>
    <field name="latencyNanos" id="15" type="int64"/>
    <field name="participationCap" id="16" type="Quantity"/>
    <field name="passiveAllowed" id="17" type="uint8"/>
    <field name="aggressiveAllowed" id="18" type="uint8"/>
    <field name="exclusion" id="19" type="VenueExclusion"/>
    <field name="evaluatedQuantity" id="20" type="Quantity"/>
    <field name="allocatedQuantity" id="21" type="Quantity"/>
    <field name="passive" id="22" type="uint8"/>
    <field name="fillProbability" id="23" type="Decimal9"/>
    <field name="queueWaitNanos" id="24" type="int64"/>
    <field name="impactCost" id="25" type="Decimal9"/>
    <field name="passiveCost" id="26" type="Decimal9"/>
    <field name="aggressiveCost" id="27" type="Decimal9"/>
    <field name="chosenCost" id="28" type="Decimal9"/>
  </sbe:message>

  <sbe:message name="ChildOrderTransition" id="82" description="Audit record of one router child order state change or applied fill">
    <field name="clOrdId" id="1" type="int64"/>
    <field name="parentId" id="2" type="int64"/>
    <field name="venueId" id="3" type="VenueId"/>
    <field name="fromState" id="4" type="ChildState"/>
    <field name="toState" id="5" type="ChildState"/>
    <field name="cause" id="6" type="TransitionCause"/>
    <field name="execId" id="7" type="int64"/>
    <field name="orderedQuantity" id="8" type="Quantity"/>
    <field name="cumQuantity" id="9" type="Quantity"/>
    <field name="leavesQuantity" id="10" type="Quantity"/>
    <field name="cancelledQuantity" id="11" type="Quantity"/>
    <field name="timestampNanos" id="12" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="PostTradeBust" id="100" description="A venue, clearing house or operator cancels a trade after execution">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="tradeSource" id="2" type="TradeSource"/>
    <field name="tradeId" id="3" type="int64" description="execId for an Execution trade, quoteId for an Rfq trade"/>
    <field name="venueOrderId" id="4" type="int64" description="Venue order id of the busted trade, 0 for an Rfq trade"/>
    <field name="instrumentId" id="5" type="InstrumentId"/>
    <field name="reason" id="6" type="BustReason"/>
    <field name="timestampNanos" id="7" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="TradeAmend" id="101" description="A correction to the price or quantity of a booked trade, with the person who made it">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="tradeSource" id="2" type="TradeSource"/>
    <field name="tradeId" id="3" type="int64"/>
    <field name="newPrice" id="4" type="Decimal9"/>
    <field name="newQuantity" id="5" type="Quantity"/>
    <field name="amendedBy" id="6" type="PartyId"/>
    <field name="reason" id="7" type="AmendReason"/>
    <field name="timestampNanos" id="8" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="MarketDataReject" id="40" description="A market data input rejected by the quality layer, journaled with its reason">
    <field name="sourceId" id="1" type="int32" description="Quote source or feed the input came from"/>
    <field name="instrumentId" id="2" type="InstrumentId"/>
    <field name="reason" id="3" type="MdRejectReason"/>
    <field name="bidPrice" id="4" type="Decimal9"/>
    <field name="askPrice" id="5" type="Decimal9"/>
    <field name="referencePrice" id="6" type="Decimal9" description="Reference the input was checked against, 0 if none"/>
    <field name="sourceSeqNo" id="7" type="SeqNo"/>
    <field name="sourceNanos" id="8" type="EpochNanos" description="Time stamp carried by the input"/>
    <field name="timestampNanos" id="9" type="EpochNanos" description="Time the rejection was decided"/>
  </sbe:message>

  <sbe:message name="OrderCancel" id="41" description="Outbound request to cancel a resting order">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="clOrdId" id="2" type="int64"/>
    <field name="origClOrdId" id="3" type="int64"/>
    <field name="instrumentId" id="4" type="InstrumentId"/>
    <field name="side" id="5" type="Side"/>
    <field name="quantity" id="6" type="Quantity"/>
    <field name="sentNanos" id="7" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="OrderReplace" id="42" description="Outbound request to change price or quantity of a resting order">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="clOrdId" id="2" type="int64"/>
    <field name="origClOrdId" id="3" type="int64"/>
    <field name="instrumentId" id="4" type="InstrumentId"/>
    <field name="side" id="5" type="Side"/>
    <field name="price" id="6" type="Decimal9"/>
    <field name="quantity" id="7" type="Quantity"/>
    <field name="sentNanos" id="8" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="QuoteCancel" id="43" description="Outbound withdrawal of a live RFQ quote">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="rfqId" id="2" type="int64"/>
    <field name="quoteId" id="3" type="int64"/>
    <field name="instrumentId" id="4" type="InstrumentId"/>
    <field name="sentNanos" id="5" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="TradeBust" id="44" description="Venue cancelled an earlier fill (FIX ExecType H)">
    <field name="venueId" id="1" type="VenueId"/>
    <field name="clOrdId" id="2" type="int64"/>
    <field name="execId" id="3" type="int64" description="Execution being busted"/>
    <field name="instrumentId" id="4" type="InstrumentId"/>
    <field name="side" id="5" type="Side"/>
    <field name="price" id="6" type="Decimal9"/>
    <field name="quantity" id="7" type="Quantity"/>
    <field name="timestampNanos" id="8" type="EpochNanos"/>
  </sbe:message>

</sbe:messageSchema>
