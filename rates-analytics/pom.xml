<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.ratesalgo</groupId>
    <artifactId>rates-algo-trading</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>rates-analytics</artifactId>
  <name>rates-analytics</name>
  <description>Rates analytics: calendars, day counts and schedules; discount curves and the multi-curve bootstrap; OIS swap, government bond, futures and funding analytics; the DV01 ladder consumed by the risk engine. Pure Java, double arithmetic, preallocated workspaces on pricing paths.</description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The QuantLib golden and the data fixtures live at the repository root (DR-006). -->
            <rates.repo.root>${maven.multiModuleProjectDirectory}</rates.repo.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
