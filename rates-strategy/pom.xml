<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.ratesalgo</groupId>
    <artifactId>rates-algo-trading</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rates-strategy</artifactId>
  <name>rates-strategy</name>
  <description>Desk features that move market-making P&amp;L and cost: internalisation and netting, axes, quote sizing, client tiering from markouts, hedge timing, funding and balance-sheet penalty, and the desk P&amp;L view, each behind an interface whose default is today's behaviour, with the pre-registered back-test experiments that measure them.</description>

  <dependencies>
    <dependency>
      <groupId>io.ratesalgo</groupId>
      <artifactId>rates-backtest</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.ratesalgo</groupId>
      <artifactId>rates-quoting</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.ratesalgo</groupId>
      <artifactId>rates-hedge</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.ratesalgo</groupId>
      <artifactId>rates-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.ratesalgo</groupId>
      <artifactId>rates-messages</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.agrona</groupId>
      <artifactId>agrona</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <ratesalgo.repoRoot>${maven.multiModuleProjectDirectory}</ratesalgo.repoRoot>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
